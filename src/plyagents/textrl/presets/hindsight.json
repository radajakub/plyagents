{
  "description": "Hindsight: LLM Q critic; the actor loss and the critic loss are each shown the whole game and the outcome in one call per game.",
  "spec": "actor=llm[budget=4000,apply=compress[reduce=mean]],critic=llm_q[budget=4000,apply=compress[reduce=mean]],actor_loss=llm[lesson_chars=200,inputs=outcome+trajectory],critic_loss=llm[target=mc,inputs=trajectory,note_chars=200]",
  "defines": {
    "actor": "llm[memory=true]",
    "critic": "llm_q",
    "feedback": "none",
    "actor_loss": "llm[inputs=outcome+trajectory]",
    "critic_loss": "llm[target=mc,inputs=trajectory]",
    "sweep": "episode"
  }
}
